@"
# Python-ish .gitignore
.venv/
env/
__pycache__/
*.pyc
.ipynb_checkpoints/
# Common large artefacts
*.mp4
*.mkv
*.zip
*.7z
*.tar
*.gz
*.bin
*.pt
*.pth
*.pkl
*.h5
*.onnx
*.parquet
"@ | Out-File -Encoding utf8 .gitignore
git add .gitignore
git commit -m "Add .gitignore for large/derived files"
.env